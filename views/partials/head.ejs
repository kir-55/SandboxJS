<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title + ' — ' : '' %>
            <%= name %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,700;1,9..144,300&family=DM+Sans:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <script>
        // Sticky header shadow on scroll
        window.addEventListener('DOMContentLoaded', () => {
            const header = document.querySelector('.site-header');
            if (!header) return;
            const toggle = () => header.classList.toggle('scrolled', window.scrollY > 10);
            window.addEventListener('scroll', toggle, { passive: true });
            toggle();
        });
    </script>
</head>

<body>