<%- include('partials/head') %>
    <%- include('partials/header') %>
        <style>
            h2 {
                width: 100%;
                text-align: center;
                color: black;
                font-size: 2rem;
            }

            .saves-grid {
                display: flex;
                gap: 20px;
                justify-content: center;
                flex-wrap: wrap;
            }

            .save-card-link {
                text-decoration: none;
                color: inherit;
                display: block;
            }

            .save-card {
                background: #ffffff;
                border-radius: 8px;
                padding: 15px;
                text-align: center;
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
                transition: transform 0.2s, box-shadow 0.2s;
                width: 200px;
            }

            .save-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            }

            .save-card canvas {
                background: #1e1e1e;
                border-radius: 4px;
                margin-bottom: 10px;
                width: 100%;
                height: auto;
            }

            .save-card h3 {
                margin: 10px 0 5px;
                font-size: 1.1rem;
                word-break: break-word;
            }

            .save-card p {
                font-size: 0.8rem;
                color: #504c4c;
                margin: 5px 0;
            }

            .author {
                font-style: italic;
                font-weight: bold;
            }
        </style>

        <main>
            <script>
                const simulationBackgroundColor = '<%= simulation_background_color %>';
            </script>
            <script src="/js/utils/helpers.js"></script>
            <script src="/js/classes/grains.js"></script>
            <script src="/js/rendering.js"></script>
            <h2>Discover Worlds</h2>
            <% if (worlds.length) { %>
                <div class="saves-grid">
                    <% worlds.forEach(world=> { %>
                        <a href="/simulation?clone=<%= world.id %>" class="save-card-link">
                            <div class="save-card">
                                <canvas width="<%= world.width * 2 %>" height="<%= world.height * 2 %>"
                                    id="preview_<%= world.id %>" class="save-preview"></canvas>
                                <div class="world-title-row">
                                    <h3>
                                        <%= world.world_name %>
                                    </h3>
                                    <% if (['admin', 'moderator' ].includes(locals.user.role) ) { %>
                                        <button id="deleteWorldBtn" class="delete-btn-icon" title="Delete this world"
                                            onclick="deleteWorld(<%= world.id %>, event)">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                                viewBox="0 0 24 24" fill="none" stroke="red" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0h10"></path>
                                                <line x1="10" y1="11" x2="10" y2="17"></line>
                                                <line x1="14" y1="11" x2="14" y2="17"></line>
                                            </svg>
                                        </button>
                                        <% } %>
                                </div>

                                <p>by <span class="author">
                                        <%= world.author %>
                                    </span></p>
                                <p>
                                    <%= new Date(world.updated_at).toLocaleString() %>
                                </p>
                                <script>
                                    fetch(`/api/saves/public/${<%= world.id %>}`)
                                    .then(res => res.json())
                                    .then(data => {
                                        previewSave('preview_<%= world.id %>', data.screen_data, 2);
                                    })
                                    .catch(err => console.error('Error loading preview:', err));




                                </script>
                            </div>
                        </a>
                        <% }); %>
                </div>
                <script>
                    async function deleteWorld(worldId, event) {
                        event.preventDefault();
                        event.stopPropagation();
                        if (!confirm('Delete this world? This action cannot be undone.')) return;
                        try {
                            const response = await fetch('/api/saves/moderator/' + worldId, { method: 'DELETE' });
                            if (response.ok) {
                                alert('World deleted.');
                                window.location.href = '/discover';
                            } else {
                                const data = await response.json();
                                alert(data.error || 'Delete failed');
                            }
                        } catch (err) {
                            console.error(err);
                            alert('Network error');
                        }
                    }
                </script>
                <% } else { %>
                    <p>No worlds to discover yet. Be the first to create one!</p>
                    <% } %>
        </main>
        <%- include('partials/footer') %>