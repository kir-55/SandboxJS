<%- include('partials/head') %>
    <%- include('partials/header') %>
        <style>
            /* ...existing code... */
            h2 {
                width: 100%;
                text-align: center;

                color: black;
                font-size: 2rem;
            }

            .saves-grid {
                display: flex;
                flex-wrap: wrap;
                gap: 20px;
                justify-content: center;
            }

            .save-card-link {
                text-decoration: none;
                color: inherit;
                display: block;
            }

            .save-card {
                background: #ffffff;
                border-radius: 8px;
                padding: 15px;
                text-align: center;
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
                transition: transform 0.2s, box-shadow 0.2s;
            }

            .save-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            }

            .save-card canvas {
                background: #1e1e1e;
                border-radius: 4px;
                margin-bottom: 10px;
            }

            .save-card h3 {
                margin: 10px 0 5px;
                font-size: 1.1rem;
            }

            .save-card p {
                font-size: 0.8rem;
                color: #504c4c;
            }

            /* New styles for guest/landing info */
            .guest-hero {
                max-width: 980px;
                margin: 32px auto;
                background: linear-gradient(180deg, #f7fbff 0%, #ffffff 100%);
                border-radius: 12px;
                padding: 24px;
                box-shadow: 0 6px 20px rgba(30, 30, 30, 0.06);
            }

            .hero-grid {
                display: flex;
                gap: 20px;
                align-items: center;
                flex-wrap: wrap;
                justify-content: center;
            }

            .hero-canvas-wrap {
                background: #111;
                padding: 8px;
                border-radius: 8px;
                box-shadow: inset 0 1px 0 rgba(255,255,255,0.02);
            }

            .hero-info {
                max-width: 520px;
                text-align: left;
            }

            .guest-hero h2 {
                margin: 0 0 8px 0;
                font-size: 1.8rem;
            }

            .guest-hero p.lead {
                margin: 6px 0 14px 0;
                color: #333;
                font-size: 1rem;
            }

            .features {
                display: flex;
                flex-direction: column;
                gap: 8px;
                margin: 0 0 14px 0;
                padding-left: 18px;
            }

            .cta {
                display: flex;
                flex-direction: row;
                gap: 10px;
                flex-wrap: nowrap;
            }

            li{
                list-style: none;
                position: relative;
                padding-left: 20px;
            }

            @media (max-width: 700px) {
                .hero-grid { flex-direction: column; }
            }
        </style>
        <main>
            <script>
                const simulationBackgroundColor = '<%= simulation_background_color %>';
            </script>
            <script src="/js/utils/helpers.js"></script>
            <script src="/js/classes/grains.js"></script>
            <script src="/js/rendering.js"></script>

            <% if (locals.user) { %>
                <h2>Your Saved Worlds</h2>
                <% if (saves.length) { %>
                    <div class="saves-grid">
                        <% saves.forEach(save=> { %>
                            <a href="/simulation?load=<%= encodeURIComponent(save.world_name) %>"
                                class="save-card-link">
                                <div class="save-card">
                                    <canvas width="<%= save.width * 2 %>" height="<%= save.height * 2 %>"
                                        id="save_<%= save.id %>" class="save-preview"></canvas>
                                    <h3>
                                        <%= save.world_name %>
                                    </h3>
                                    <p>
                                        <%= new Date(save.updated_at).toLocaleString() %>
                                    </p>
                                    <script>
                                        previewSave('save_<%= save.id %>', <%= JSON.stringify(save.screen_data) %>, 2);
                                    </script>
                                </div>
                            </a>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <p>You have no saved worlds yet. Start the simulation and save your creations!</p>
                        <% } %>
            <% } else { %>
                <!-- Guest / landing info -->
                <section class="guest-hero" aria-labelledby="project-title">
                    <div class="hero-grid">
                        <img src="/images/hero-bg.jpg" alt="">
                        <div class="hero-info">
                            <h2 id="project-title">SandboxJS</h2>
                            <p class="lead">Create, experiment and save sandbox-style worlds with falling particles, custom materials and simple physics. No install required - run it in your browser.</p>

                            <ul class="features">
                                <li>Real-time particle simulation with grains and fluids</li>
                                <li>Save and share worlds when you log in</li>
                                <li>Small, extendable codebase - perfect for learning and tinkering</li>
                            </ul>

                            <div class="cta">
                                <a class="btn" href="/simulation">Try the live demo</a>
                                <a class="btn" href="/login">Login / Create account</a>
                            </div>
                        </div>
                    </div>
                </section>

            <% } %>