<%- include('partials/head') %>
    <%- include('partials/header') %>
        <style>
            /* ...existing code... */
            h2 {
                width: 100%;

                text-align: center;

                color: black;
                font-size: 2rem;
            }

            .saves-grid {
                display: flex;
                flex-wrap: wrap;
                gap: 20px;
                justify-content: center;
            }

            .save-card-link {
                text-decoration: none;
                color: inherit;
                display: block;
            }

            .save-card {
                background: #ffffff;
                border-radius: 8px;
                padding: 15px;
                text-align: center;
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
                transition: transform 0.2s, box-shadow 0.2s;
            }

            .save-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            }

            .save-card canvas {
                background: #1e1e1e;
                border-radius: 4px;
                margin-bottom: 10px;
            }

            .save-card h3 {
                margin: 10px 0 5px;
                font-size: 1.1rem;
            }

            .save-card p {
                font-size: 0.8rem;
                color: #504c4c;
            }

            /* ===== NEW WELCOME SECTION (voucher style) ===== */

            .welcome-sandbox {
                background: linear-gradient(135deg, #f8f9fc 0%, #ffffff 100%);
                padding: 2rem 2rem;
                margin: 2rem auto;
                border-radius: 24px;
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
                max-width: 1200px;
            }

            .welcome-flex {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                justify-content: space-around;
                gap: 2rem;
            }

            /* Carousel styles */
            .welcome-carousel {
                flex: 1;
                min-width: 260px;
                max-width: 464px;
            }

            .carousel-frame {
                position: relative;
                border-radius: 20px;

                overflow: hidden;
            }

            .carousel-frame img {
                width: 100%;
                height: auto;
                display: block;
                aspect-ratio: 1 / 1;
                object-fit: cover;
                transition: opacity 0.2s ease;
            }

            .carousel-arrow {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                background: rgba(0, 0, 0, 0.5);
                backdrop-filter: blur(4px);
                border: none;
                font-size: 1.5rem;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                cursor: pointer;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.2s;
                font-weight: bold;
            }

            .carousel-arrow:hover {
                background: rgba(0, 0, 0, 0.8);
                transform: translateY(-50%) scale(1.05);
            }

            .prev {
                left: 12px;
            }

            .next {
                right: 12px;
            }

            .carousel-dots-mini {
                display: flex;
                justify-content: center;
                gap: 0.6rem;
                margin-top: 1rem;
            }

            .dot-mini {
                width: 8px;
                height: 8px;
                background-color: var(--accent);
                border-radius: 50%;
                cursor: pointer;
                transition: all 0.2s;
            }

            .dot-mini.active {
                background-color: var(--accent);
                transform: scale(1.2);
            }

            /* Right content */
            .welcome-content {
                flex: 1;
                min-width: 260px;
                max-width: 464px;
                text-align: center;
            }

            .welcome-headline {
                font-size: 2.2rem;
                font-weight: 700;
                color: var(--accent);
                margin-bottom: 0.5rem;
                letter-spacing: -0.5px;
            }

            .welcome-slogan {
                font-size: 1rem;
                font-weight: 500;
                color: #4a5568;
                display: inline-block;
                padding: 0.6rem 1.5rem;
                border-radius: 40px;
                margin-bottom: 1.5rem;
                line-height: 1.4;

            }

            .welcome-list {
                list-style: none;
                padding: 0;
                max-width: 400px;
                margin: 0 auto 1.8rem auto;
                text-align: left;
            }

            .welcome-list li {
                margin: 0.9rem 0;
                font-size: 0.95rem;
                display: flex;
                align-items: center;
                gap: 0.75rem;
                color: #1a202c;
                font-weight: 500;
            }

            .check-svg {
                flex-shrink: 0;
                color: #2c3e50;
                width: 20px;
                height: 20px;
            }

            .welcome-cta {
                display: flex;
                justify-content: center;
                gap: 1.2rem;
                flex-wrap: wrap;
            }

            .btn {
                display: inline-block;
                padding: 0.7rem 1.8rem;
                font-size: 0.95rem;
                font-weight: 600;
                text-decoration: none;
                border-radius: 40px;
                transition: all 0.25s ease;
                cursor: pointer;
                font-family: 'Montserrat', sans-serif;
            }



            /* Responsive */
            @media (max-width: 768px) {
                .welcome-sandbox {
                    margin: 1rem;
                    padding: 1.2rem;
                }

                .welcome-flex {
                    flex-direction: column;
                }

                .welcome-headline {
                    font-size: 1.8rem;
                }

                .btn {
                    width: 100%;
                    text-align: center;
                }
            }




            @media (max-width: 700px) {
                .hero-grid {
                    flex-direction: column;
                }
            }
        </style>
        <main>
            <script>
                const simulationBackgroundColor = '<%= simulation_background_color %>';
            </script>
            <script src="/js/utils/helpers.js"></script>
            <script src="/js/classes/grains.js"></script>
            <script src="/js/rendering.js"></script>

            <% if (locals.user) { %>
                <h2>Your Saved Worlds</h2>
                <% if (saves.length) { %>
                    <div class="saves-grid">
                        <% saves.forEach(save=> { %>
                            <a href="/simulation?load=<%= encodeURIComponent(save.world_name) %>"
                                class="save-card-link">
                                <div class="save-card">
                                    <canvas width="<%= save.width * 2 %>" height="<%= save.height * 2 %>"
                                        id="save_<%= save.id %>" class="save-preview"></canvas>
                                    <h3>
                                        <%= save.world_name %>
                                    </h3>
                                    <p>
                                        <%= new Date(save.updated_at).toLocaleString() %>
                                    </p>
                                    <script>
                                        previewSave('save_<%= save.id %>', <%= JSON.stringify(save.screen_data) %>, 2);
                                    </script>
                                </div>
                            </a>
                            <% }); %>
                    </div>
                    <% } else { %>
                        <p>You have no saved worlds yet. Start the simulation and save your creations!</p>
                        <% } %>
                            <% } else { %>
                                <!-- New beautiful welcome section inspired by voucher design -->
                                <section class="welcome-sandbox">
                                    <div class="welcome-flex">
                                        <!-- Left side: Image carousel gallery -->
                                        <div class="welcome-carousel">
                                            <div class="carousel-frame">
                                                <img id="welcomeCarouselImg" src=""
                                                    alt="SandboxJS simulation preview 1">
                                                <button class="carousel-arrow prev" aria-label="Previous">❮</button>
                                                <button class="carousel-arrow next" aria-label="Next">❯</button>
                                            </div>
                                            <div class="carousel-dots-mini"></div>
                                        </div>

                                        <!-- Right side: main content with pretty marks -->
                                        <div class="welcome-content">
                                            <div class="welcome-headline">SandboxJS</div>
                                            <div class="welcome-slogan">
                                                Create, experiment and save sandbox-style worlds with falling particles,
                                                custom materials and simple physics.
                                            </div>
                                            <ul class="welcome-list">
                                                <li>
                                                    <svg class="check-svg" width="18" height="18" viewBox="0 0 24 24"
                                                        fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <circle cx="12" cy="12" r="10" stroke="currentColor"
                                                            stroke-width="1.5" fill="none" />
                                                        <path d="M8 12L11 15L16 9" stroke="currentColor"
                                                            stroke-width="1.5" stroke-linecap="round"
                                                            stroke-linejoin="round" />
                                                    </svg>
                                                    Real-time particle simulation with grains and fluids
                                                </li>
                                                <li>
                                                    <svg class="check-svg" width="18" height="18" viewBox="0 0 24 24"
                                                        fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <circle cx="12" cy="12" r="10" stroke="currentColor"
                                                            stroke-width="1.5" fill="none" />
                                                        <path d="M8 12L11 15L16 9" stroke="currentColor"
                                                            stroke-width="1.5" stroke-linecap="round"
                                                            stroke-linejoin="round" />
                                                    </svg>
                                                    Save and share worlds when you log in
                                                </li>
                                                <li>
                                                    <svg class="check-svg" width="18" height="18" viewBox="0 0 24 24"
                                                        fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <circle cx="12" cy="12" r="10" stroke="currentColor"
                                                            stroke-width="1.5" fill="none" />
                                                        <path d="M8 12L11 15L16 9" stroke="currentColor"
                                                            stroke-width="1.5" stroke-linecap="round"
                                                            stroke-linejoin="round" />
                                                    </svg>
                                                    Small, extendable codebase – perfect for learning and tinkering
                                                </li>
                                            </ul>
                                            <div class="welcome-cta">
                                                <a class="btn btn-primary" href="/simulation">Try the live demo</a>
                                                <a class="btn btn-secondary" href="/login">Login / Create account</a>
                                            </div>
                                        </div>
                                    </div>
                                </section>
                                <script>
                                    (function () {
                                        // Replace with your own simulation preview images (or keep the SVG placeholders)
                                        const images = [
                                            '/images/sandbox_peek1.png',
                                            '/images/sandbox_peek2.png',
                                            '/images/sandbox_peek3.png',
                                            '/images/sandbox_peek4.png',
                                            '/images/sandbox_peek5.png',
                                            '/images/sandbox_peek6.png'
                                        ];
                                        let current = 0;
                                        const imgElem = document.getElementById('welcomeCarouselImg');
                                        const dotsContainer = document.querySelector('.carousel-dots-mini');
                                        let interval;

                                        function updateCarousel() {
                                            if (imgElem) imgElem.src = images[current];
                                            const dots = document.querySelectorAll('.dot-mini');
                                            dots.forEach((dot, i) => {
                                                if (i === current) dot.classList.add('active');
                                                else dot.classList.remove('active');
                                            });
                                        }

                                        function next() {
                                            current = (current + 1) % images.length;
                                            updateCarousel();
                                            resetTimer();
                                        }

                                        function prev() {
                                            current = (current - 1 + images.length) % images.length;
                                            updateCarousel();
                                            resetTimer();
                                        }

                                        function resetTimer() {
                                            if (interval) clearInterval(interval);
                                            interval = setInterval(next, 2000);
                                        }

                                        function createDots() {
                                            if (!dotsContainer) return;
                                            dotsContainer.innerHTML = '';
                                            images.forEach((_, idx) => {
                                                const dot = document.createElement('span');
                                                dot.classList.add('dot-mini');
                                                if (idx === current) dot.classList.add('active');
                                                dot.addEventListener('click', () => {
                                                    current = idx;
                                                    updateCarousel();
                                                    resetTimer();
                                                });
                                                dotsContainer.appendChild(dot);
                                            });
                                        }

                                        document.addEventListener('DOMContentLoaded', () => {
                                            createDots();
                                            updateCarousel();
                                            const prevBtn = document.querySelector('.carousel-arrow.prev');
                                            const nextBtn = document.querySelector('.carousel-arrow.next');
                                            if (prevBtn) prevBtn.addEventListener('click', prev);
                                            if (nextBtn) nextBtn.addEventListener('click', next);
                                            resetTimer();
                                        });
                                    })();
                                </script>
                                <% } %>