<%- include('partials/head') %>
    <%- include('partials/header') %>
        <div class="main-layout">
            <div class="center">
                <% if (locals.user) { %>
                    <div class="world-name-control">
                        <input type="text" id="worldNameInput" placeholder="Enter world name" value="Untitled">
                        <% if (saveData && !saveData.isClone) { %>
                            <button id="deleteWorldBtn" class="delete-btn-icon" title="Delete this world">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                    fill="none" stroke="red" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0h10"></path>
                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                </svg>
                            </button>
                            <% } %>
                    </div>
                    <% } %>
                        <canvas id="canvas"></canvas>
                        <p id="grainName">Air</p>
                        <div class="button-container">
                            <div id="materialMenu">
                                <canvas id="grainMenu"></canvas>
                                <div>
                                    <button onclick="prevGrain()" class="button-19">
                                        < </button>
                                            <canvas id="materialPreview" width="48" height="48"></canvas>
                                            <button onclick="nextGrain()" class="button-19">></button>
                                </div>
                            </div>
                            <div class="port-buttons-container">
                                <input type="range" id="brushSize" min="1" max="20" value="3"
                                    oninput="setBrushSize(this.value)">
                                <div class="port-buttons-container">
                                    <button class="button-19" onclick="importFromFile()">Import</button>
                                    <button class="button-19" onclick="exportToFile()">Export</button>
                                    <% if (locals.user) { %>
                                        <button class="button-19" onclick="saveToDatabase()"
                                            id="saveDbBtn">Save</button>
                                        <% } %>
                                </div>
                            </div>
                        </div>
                        <input type="file" id="fileInput" accept=".sx,.json" style="display:none">
            </div>

            <!-- Grain info side panel (right) -->
            <button class="open-btn" id="open-btn" aria-label="Open grain info">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 4a2 2 0 0 1 2-2h6v20H4a2 2 0 0 1-2-2z"></path>
                    <path d="M22 4a2 2 0 0 0-2-2h-6v20h6a2 2 0 0 0 2-2z"></path>
                </svg>
            </button>
            <div class="side-panel" id="side-panel" style="display: none">
                <div class="side-panel-header">
                    <h3 class="grain-name" id="side-panel-grain-name">Grain Name</h3>
                    <button class="close-btn" aria-label="Close panel" id="close-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <p class="grain-description" id="side-panel-grain-description">this is base grain, has no functionality,
                    may be affected by gravity</p>
                <div class="canvas-container">
                    <canvas id="example-canvas"></canvas>
                </div>
            </div>
        </div>

        <script>
            const simulationBackgroundColor = '<%= simulation_background_color %>';
    <% if (saveData) { %>
                window.loadedScreenData = <%= JSON.stringify(saveData.screen_data) %>;
                window.loadedWidth = <%= saveData.width %>;
                window.loadedHeight = <%= saveData.height %>;
                window.loadedWorldName = '<%= saveData.world_name %>';
    <% } %>
        </script>

        <script>
    // Set initial world name
    const nameInput = document.getElementById('worldNameInput');
            if (nameInput) {
                if (window.loadedWorldName) {
                    nameInput.value = window.loadedWorldName;
                } else {
                    // Generate a unique name: "Untitled_" + random hash
                    const hash = Math.random().toString(36).substring(2, 6);
                    nameInput.value = `Untitled_${hash}`;
                }
            }

            // Delete world function
            const deleteBtn = document.getElementById('deleteWorldBtn');
            if (deleteBtn) {
                deleteBtn.addEventListener('click', async () => {
                    const worldName = window.loadedWorldName;
                    if (!worldName) return;
                    if (!confirm(`Delete world "${worldName}"? This action cannot be undone.`)) return;
                    try {
                        const response = await fetch(`/api/saves/${encodeURIComponent(worldName)}`, { method: 'DELETE' });
                        if (response.ok) {
                            alert(`World "${worldName}" deleted.`);
                            window.location.href = '/'; // redirect to home
                        } else {
                            const data = await response.json();
                            alert(data.error || 'Delete failed');
                        }
                    } catch (err) {
                        console.error(err);
                        alert('Network error');
                    }
                });
            }
        </script>

        <script src="/js/utils/helpers.js"></script>
        <script src="/js/classes/grains.js"></script>
        <script src="/js/classes/simulation.js"></script>
        <script src="/js/rendering.js"></script>
        <script src="/js/port.js"></script>
        <script src="/js/input-handlers.js"></script>
        <script src="/js/main.js"></script>
        <script src="/js/example.js"></script>

        <%- include('partials/footer') %>