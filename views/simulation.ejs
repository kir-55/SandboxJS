<%- include('partials/head') %>
    <%- include('partials/header') %>
        <div class="main-layout">
            <div class="center">
                <br>
                <canvas id="canvas"></canvas>
                <br>
                <p id="grainName">Air</p>
                <div class="button-container">
                    <div id="materialMenu">
                        <canvas id="grainMenu"></canvas>
                        <div>
                            <button onclick="prevGrain()" class="button-19">
                                < </button>
                                    <canvas id="materialPreview" width="48" height="48"></canvas>
                                    <button onclick="nextGrain()" class="button-19">></button>
                        </div>

                    </div>
                    <input type="range" id="brushSize" min="1" max="20" value="3" oninput="setBrushSize(this.value)">


                </div>

                <input type="file" id="fileInput" accept=".sx,.json" style="display:none">
                <button onclick="importFromFile()">Import</button>
                <button onclick="exportToFile()">Export</button>
                <button onclick="saveToDatabase()">Save</butto>
            </div>
            <button class="open-btn" id="open-btn" aria-label="Open grain info">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 4a2 2 0 0 1 2-2h6v20H4a2 2 0 0 1-2-2z"></path>
                    <path d="M22 4a2 2 0 0 0-2-2h-6v20h6a2 2 0 0 0 2-2z"></path>
                </svg>
            </button>
            <div class="side-panel" id="side-panel" style="display: none">

                <div class="side-panel-header">
                    <h3 class="grain-name" id="side-panel-grain-name">Grain Name</h3>
                    <button class="close-btn" aria-label="Close panel" id="close-btn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <p class="grain-description" id="side-panel-grain-description">this is base grain, has no
                    functionality,
                    may be affected by gravity</p>
                <div class="canvas-container">
                    <canvas id="example-canvas"></canvas>
                </div>
            </div>
        </div>

        <script>
            const simulationBackgroundColor = '<%= simulation_background_color %>';
            // Conditionally define screen if saveData is provided
            console.log("not loaded loaded loaded");
            <% if (saveData) { %>
                // Use JSON.stringify to safely embed the array
                window.loadedScreenData = <%= JSON.stringify(saveData.screen_data) %>;
                window.loadedWidth = <%= saveData.width %>;
                window.loadedHeight = <%= saveData.height %>;
                console.log("loaded loaded loaded");
                // We'll set these in main.js after it loads, but we can define them here
                // Note: This must run before main.js, but we need to ensure main.js uses them
            <% } %>
        </script>

        <script src="/js/utils/helpers.js"></script>
        <script src="/js/classes/grains.js"></script>
        <script src="/js/classes/simulation.js"></script>
        <script src="/js/rendering.js"></script>
        <script src="/js/port.js"></script>
        <script src="/js/input-handlers.js"></script>


        <script src="/js/main.js"></script>
        <script src="/js/example.js"></script>

        <%- include('partials/footer') %>